[Unit]
Description=Admiral Anti-Adblock Domain Detector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admiral
Group=admiral
RuntimeDirectory=admiral_detector
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/admiral-detector -c /etc/admiral_detector/admiral_detector.conf
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/admiral_detector /var/lib/admiral_detector /var/log/admiral_detector
