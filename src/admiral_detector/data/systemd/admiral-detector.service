[Unit]
Description=Admiral Anti-Adblock Domain Detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admiral
Group=admiral
ExecStart=/usr/local/bin/admiral-detector daemon -c /etc/admiral_detector/admiral_detector.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/admiral_detector /var/log/admiral_detector

[Install]
WantedBy=multi-user.target